{
  "private": true,
  "name": "all-code-checker-typescript-helper",
  "version": "0.1.0",
  "scripts": {
    "format": "prettier --write analyze.cjs verify-strict-null.cjs package.json ../../.github/workflows/ci.yml ../../docs/development-formatting.md",
    "format:check": "prettier --check analyze.cjs verify-strict-null.cjs package.json ../../.github/workflows/ci.yml ../../docs/development-formatting.md",
    "test": "node --test verify-strict-null.cjs"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
