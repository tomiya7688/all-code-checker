<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>all-code-checker</AssemblyName>
    <RootNamespace>AllCodeChecker.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AllCodeChecker.Core/AllCodeChecker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AllCodeChecker.Cli.Tests" />
  </ItemGroup>

  <Target Name="BundleTypeScriptRuntime" AfterTargets="Build"
          Condition="'$(SkipTypeScriptPackaging)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../AllCodeChecker.TypeScript/package-runtime.mjs&quot; &quot;$(TargetPath)&quot;" />
  </Target>

  <Target Name="BundlePublishedTypeScriptRuntime" AfterTargets="Publish"
          Condition="'$(SkipTypeScriptPackaging)' != 'true'">
    <Exec Command="node &quot;$(MSBuildProjectDirectory)/../AllCodeChecker.TypeScript/package-runtime.mjs&quot; &quot;$(PublishDir)$(TargetFileName)&quot;" />
  </Target>
</Project>
