<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>all-code-checker</AssemblyName>
    <RootNamespace>AllCodeChecker.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="../AllCodeChecker.Core/AllCodeChecker.Core.csproj"
    />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AllCodeChecker.Cli.Tests" />
  </ItemGroup>

  <Target
    Name="KeepFastParseNativeAssetSeparate"
    AfterTargets="ComputeResolvedFilesToPublishList"
    Condition="'$(RuntimeIdentifier)' == 'win-x64'"
  >
    <!-- NuGet supplies FastParse.dll and native fastparse.dll; Windows publish paths are case insensitive. -->
    <ItemGroup>
      <ResolvedFileToPublish
        Update="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('runtimes')) and '%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'fastparse.dll'"
      >
        <RelativePath>runtimes/win-x64/native/fastparse.dll</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target
    Name="BundleTypeScriptRuntime"
    AfterTargets="Build"
    Condition="'$(SkipTypeScriptPackaging)' != 'true'"
  >
    <Exec
      Command="node &quot;$(MSBuildProjectDirectory)/../AllCodeChecker.TypeScript/package-runtime.mjs&quot; &quot;$(TargetPath)&quot; &quot;$(RuntimeIdentifier)&quot;"
    />
  </Target>

  <Target
    Name="BundlePublishedTypeScriptRuntime"
    AfterTargets="Publish"
    Condition="'$(SkipTypeScriptPackaging)' != 'true'"
  >
    <Exec
      Command="node &quot;$(MSBuildProjectDirectory)/../AllCodeChecker.TypeScript/package-runtime.mjs&quot; &quot;$(PublishDir)$(TargetFileName)&quot; &quot;$(RuntimeIdentifier)&quot;"
    />
  </Target>
</Project>
